# Copy this file to .env and edit as needed.

# Server port
PORT=4001

# MongoDB connection string.
# Local MongoDB:            
# MongoDB Atlas (cloud):     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aquaguard
MONGO_URI=mongodb+srv://fatimaumer862_db_user:ZkpFC9rO9xxT2IuR@cluster0.ueb7x9q.mongodb.net/aquaguard?appName=Cluster0

# Where the Python FastAPI ML service is running.
# This is the backend you already built - keep it running on this port.
ML_API_URL=http://localhost:8000

# Your Next.js frontend origin, for CORS
FRONTEND_ORIGIN=http://localhost:3000

# How many recent readings per stream to send to the ML /trend endpoint
TREND_HISTORY_SIZE=10

# Secret used to sign login tokens (JWT). Change this to any long random
# string before deploying anywhere real - the default below is fine for
# local development only.
JWT_SECRET=aquaguard-dev-secret-change-me
JWT_EXPIRES_IN=7d